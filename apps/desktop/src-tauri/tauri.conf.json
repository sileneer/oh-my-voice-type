{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oh-my-voice-type",
  "version": "0.1.0",
  "identifier": "io.github.sileneer.ohmyvoicetype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "oh-my-voice-type",
        "width": 980,
        "height": 720,
        "resizable": true,
        "center": true
      },
      {
        "label": "pill",
        "title": "Recording",
        "url": "index.html?view=pill",
        "width": 340,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQzBDMjk1Q0NENjhCMDIKUldRQ2k5Yk1sY0xBZ2FBWDI0Zmt3bHRyRFY3S2ZDS2hCM3VxdDlhMSt3MTVVTjNKSXF4bUYwUXUK",
      "endpoints": [
        "https://github.com/sileneer/oh-my-voice-type/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "dmg", "app"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "signingIdentity": "-"
    }
  }
}
